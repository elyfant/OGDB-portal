# Copy to `.env` on the production server and fill in real values.
# Never commit the real .env — it's gitignored.

# Fresh credentials — do NOT reuse the dev values from ogdb-test.
POSTGRES_USER=ogdb
POSTGRES_PASSWORD=generate-a-real-random-password
POSTGRES_DB=ogdb

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A different secret than dev's — never share JWT_SECRET across environments.
JWT_SECRET=generate-a-real-random-secret
JWT_EXPIRES_IN=7d

# The UiB subdomain pointed at this server's IP.
DOMAIN=ogdb.uib.no

# Leave unset (defaults to true) once behind Caddy/HTTPS.
# Set to false ONLY while running Phase 1 (plain HTTP, no domain yet) —
# otherwise the browser silently discards the login session cookie.
# COOKIE_SECURE=false
