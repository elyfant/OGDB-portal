# Copy to `.env` on the production server and fill in real values.
# Never commit the real .env — it's gitignored.

# Fresh credentials — do NOT reuse the dev values from ogdb-test.
POSTGRES_USER=ogdb
POSTGRES_PASSWORD=generate-a-real-random-password
POSTGRES_DB=ogdb

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A different secret than dev's — never share JWT_SECRET across environments.
JWT_SECRET=generate-a-real-random-secret
JWT_EXPIRES_IN=7d

# The UiB subdomain pointed at this server's IP (158.37.65.36).
DOMAIN=ogdb.uib.no
